# ─────────────────────────────────────────────────────────────────────────────
# NorthSign — PRODUCTION environment template (Phase 3, Step 2)
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` on the VM, fill in real values, chmod 600. NEVER commit
# real values — this file is a template only (decision D-005).
#
#   cp .env.production.example .env
#   chmod 600 .env
#
# Every runtime component below is pinned to AWS ca-central-1 (Montreal) —
# see DEPLOYMENT.md for the residency claim. If a value here must point
# somewhere else, STOP and re-read the architecture rule (D-017).
# ─────────────────────────────────────────────────────────────────────────────

# [[COMPOSE — POSTGRES container credentials]]
# Used only by the `database` service in docker-compose.prod.yml. Pick a
# strong password (openssl rand -base64 24). The app itself connects via
# NEXT_PRIVATE_DATABASE_URL below.
POSTGRES_USER=northsign
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand
POSTGRES_DB=northsign

# [[URLS]]
# Public URL users see. Must match the Caddy host in docker/production/Caddyfile.
NEXT_PUBLIC_WEBAPP_URL=https://app.northsign.ca
# URL the app uses to call itself (local background jobs, rendering).
# `app` is the compose service name — reachable only inside the stack.
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://app:3000
# Optional: sub-path the app is served under. Leave empty (served at root).
NEXT_PUBLIC_BASE_PATH=

# [[SERVER]]
# Port the Node server listens on inside the container (default 3000).
PORT=3000

# [[AUTH]]
# Secret used to sign session cookies. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# [[CRYPTO]]
# Application keys for symmetric encryption of document fields, signatures,
# webhooks etc. Generate each: openssl rand -base64 32 (≥32 chars required).
# WARNING: rotating these breaks decryption of previously stored data —
# back them up with the database backups.
NEXT_PRIVATE_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# [[DATABASE]]
# Points at the `database` compose service (hostname `database`, port 5432).
# URL-encode special characters in the password (e.g. %40 for @).
NEXT_PRIVATE_DATABASE_URL=postgres://northsign:CHANGE_ME@database:5432/northsign
# Direct (non-pooled) URL for migrations and admin commands. Same value here.
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgres://northsign:CHANGE_ME@database:5432/northsign

# [[SIGNING]]
# Local signing transport — certificate file lives on the VM and is mounted
# read-only into the container (docker-compose.prod.yml). Generate the .p12
# once per VM: see SIGNING.md at the repo root.
NEXT_PRIVATE_SIGNING_TRANSPORT=local
# Path INSIDE the container — matches the compose volume mount ./cert.p12.
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/northsign/cert.p12
# Passphrase you set when generating the .p12 (openssl rand -base64 24).
NEXT_PRIVATE_SIGNING_PASSPHRASE=CHANGE_ME_must_match_cert_p12
# Optional: contact info embedded in PDF signatures (defaults to WEBAPP_URL).
# NEXT_PUBLIC_SIGNING_CONTACT_INFO=NorthSign — https://app.northsign.ca

# [[STORAGE — S3, ca-central-1]]
# Upload transport. PRODUCTION USES S3 (database transport is dev-only).
# Buckets/IAM are created by docs/runbooks/01-storage-s3.md.
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
# Real AWS S3: leave the endpoint and force-path-style empty.
NEXT_PRIVATE_UPLOAD_ENDPOINT=
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE=false
# THE residency line — documents live in ca-central-1 (Montreal).
NEXT_PRIVATE_UPLOAD_REGION=ca-central-1
# Bucket for live documents (versioning ON — see runbook 01).
NEXT_PRIVATE_UPLOAD_BUCKET=northsign-documents
# Credentials of the AppUser IAM user created in runbook 01 (least privilege:
# documents bucket CRUD + backups bucket PutObject). From the IAM console.
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=CHANGE_ME_AppUser_access_key
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME_AppUser_secret_key
# Optional: CloudFront/CDN domain for downloads. NOT used at MVP — if added
# later it must satisfy the Canadian-region rule (D-017).
# NEXT_PRIVATE_UPLOAD_DISTRIBUTION_DOMAIN=

# [[SMTP — AWS SES, ca-central-1]]
# SMTP interface of SES in Montreal. Runbook: docs/runbooks/02-email-ses.md.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
# 587 = STARTTLS (nodemailer negotiates TLS automatically). Do not set
# SMTP_SECURE for 587 — SES rejects plaintext.
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_SECURE=
NEXT_PRIVATE_SMTP_UNSAFE_IGNORE_TLS=
# SMTP credentials generated in the SES console (SMTP settings → Create SMTP
# credentials). These are NOT the same as the AppUser keys above.
NEXT_PRIVATE_SMTP_USERNAME=CHANGE_ME_ses_smtp_username
NEXT_PRIVATE_SMTP_PASSWORD=CHANGE_ME_ses_smtp_password
# Sender identity — subdomain of the verified SES domain (not the apex).
NEXT_PRIVATE_SMTP_FROM_NAME=NorthSign
NEXT_PRIVATE_SMTP_FROM_ADDRESS=no-reply@mail.northsign.ca

# [[SUPPORT EMAIL]]
# Overrides the branding-module default (packages/lib/constants/brand.ts).
NEXT_PUBLIC_SUPPORT_EMAIL=support@northsign.ca

# [[UPLOAD LIMIT]]
# Max document size users can upload, in MB.
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=25

# [[BACKGROUND JOBS]]
# local = jobs run in-process (no external queue). Keep for MVP.
NEXT_PRIVATE_JOBS_PROVIDER=local
# Only needed if switching to bullmq/inngest later — must then satisfy D-017.
# NEXT_PRIVATE_REDIS_URL=

# [[FEATURES]]
# PostHog / feature flags: leave empty (disabled).
NEXT_PUBLIC_POSTHOG_KEY=
# Billing (EE Stripe module) lands in Phase 6 — leave empty for now.
NEXT_PUBLIC_FEATURE_BILLING_ENABLED=
# Signup controls. All empty = email/password + OAuth signup enabled.
NEXT_PUBLIC_DISABLE_SIGNUP=
NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNUP=
NEXT_PUBLIC_DISABLE_GOOGLE_SIGNUP=
NEXT_PUBLIC_DISABLE_MICROSOFT_SIGNUP=
NEXT_PUBLIC_DISABLE_OIDC_SIGNUP=
NEXT_PUBLIC_DISABLE_SIGNIN=
NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNIN=
NEXT_PUBLIC_DISABLE_GOOGLE_SIGNIN=
NEXT_PUBLIC_DISABLE_MICROSOFT_SIGNIN=
NEXT_PUBLIC_DISABLE_OIDC_SIGNIN=
NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=

# [[TELEMETRY]]
# Disable upstream anonymous telemetry — NorthSign is a privacy-first product.
DOCUMENSO_DISABLE_TELEMETRY=true

# [[TURNSTILE — OPTIONAL, later phase]]
# Cloudflare Turnstile on signup/signin. Credentials come from the Cloudflare
# dashboard. Optional at MVP.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PRIVATE_TURNSTILE_SECRET_KEY=

# [[OAUTH — OPTIONAL]]
# Google/Microsoft/OIDC sign-in. Leave empty for email/password only.
# NEXT_PRIVATE_GOOGLE_CLIENT_ID=
# NEXT_PRIVATE_GOOGLE_CLIENT_SECRET=
# NEXT_PRIVATE_MICROSOFT_CLIENT_ID=
# NEXT_PRIVATE_MICROSOFT_CLIENT_SECRET=
# NEXT_PRIVATE_OIDC_WELL_KNOWN=
# NEXT_PRIVATE_OIDC_CLIENT_ID=
# NEXT_PRIVATE_OIDC_CLIENT_SECRET=

# [[EE ONLY — OPTIONAL]]
# SES credentials for the EE "email domains" verification feature (Phase 6).
# Same region rule applies. Not needed at MVP.
# NEXT_PRIVATE_SES_ACCESS_KEY_ID=
# NEXT_PRIVATE_SES_SECRET_ACCESS_KEY=
# NEXT_PRIVATE_SES_REGION=ca-central-1

# [[DOCUMENT CONVERSION — OPTIONAL]]
# Gotenberg container for DOCX→PDF uploads. If enabled, the container MUST
# run on this VM (ca-central-1) to keep the residency claim.
# NEXT_PRIVATE_DOCUMENT_CONVERSION_URL=http://gotenberg:3005
# NEXT_PRIVATE_DOCUMENT_CONVERSION_TIMEOUT_MS=30000

# [[LOGGER — OPTIONAL]]
# File for pino output. Leave empty to log to stdout (docker logs).
# NEXT_PRIVATE_LOGGER_FILE_PATH=/tmp/northsign.log

# [[PLAIN SUPPORT — OPTIONAL]]
# NEXT_PRIVATE_PLAIN_API_KEY=
